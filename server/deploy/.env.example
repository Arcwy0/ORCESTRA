# Copy to `.env` on the GPU server and edit paths/ports as needed.

# Local directory where the model is downloaded on the server.
MODEL_DIR=/workspace/models/qwen3-vl-8b-instruct-fp8

# Optional Hugging Face cache directory.
HF_CACHE_DIR=/workspace/hf_cache

# Optional if the model requires auth or you hit HF rate limits.
HF_TOKEN=
HF_XET_HIGH_PERFORMANCE=1

# Recommended first model for RTX 4090 24 GB.
VLM_MODEL_ID=Qwen/Qwen3-VL-8B-Instruct-FP8
VLM_MODEL_NAME=Qwen/Qwen3-VL-8B-Instruct-FP8

# External ports.
VLLM_PORT=8000
GATEWAY_PORT=8080

# Conservative defaults for a single 24 GB RTX 4090.
VLLM_MAX_MODEL_LEN=8192
VLLM_GPU_MEMORY_UTILIZATION=0.88
VLLM_LOGGING_LEVEL=INFO
ROBOT_AI_MODEL_TIMEOUT_S=240
ROBOT_AI_MAX_TOKENS=2048
# Qwen returns grounding boxes/points in a 0-1000 top-left image grid.
# Set to pixel only if you use a model that returns absolute image pixels.
ROBOT_AI_VLM_COORD_FORMAT=qwen_1000

# vLLM image. Pin this later after the first successful run.
VLLM_IMAGE=vllm/vllm-openai:latest

# Gateway ASR mode.
# disabled: Unity text commands only, or Unity sends text already.
# mock: deterministic transcript for gateway tests.
# openai_compatible: forward WAV to a separate /audio/transcriptions endpoint.
ROBOT_AI_ASR_MODE=disabled
ROBOT_AI_ASR_BASE_URL=http://vllm:8000/v1
ROBOT_AI_ASR_MODEL=
ROBOT_AI_ASR_API_KEY=
ROBOT_AI_ASR_MODEL_ID=Systran/faster-whisper-base.en
ROBOT_AI_ASR_MODEL_DIR_HOST=/workspace/models/asr/faster-whisper-base.en
ROBOT_AI_ASR_MODEL_DIR=/models/asr/faster-whisper-base.en
ROBOT_AI_ASR_DEVICE=cpu
ROBOT_AI_ASR_COMPUTE_TYPE=int8

# Saved raw and annotated request images.
ROBOT_AI_SAVE_IMAGES=1
ROBOT_AI_SAVE_TRACES=1
# Host directory mounted into the gateway. With this default, images appear at
# server/deploy/outputs/robot_ai on the Docker host.
ROBOT_AI_OUTPUT_DIR_HOST=./outputs/robot_ai

# Usually empty for local vLLM.
ROBOT_AI_API_KEY=
