<?xml version="1.0" ?>
<!--
  Flattened UR3 URDF generated from the official ros-industrial/universal_robot
  (noetic-devel) xacro + config files:
    - config/ur3/default_kinematics.yaml
    - config/ur3/joint_limits.yaml
    - config/ur3/physical_parameters.yaml
    - config/ur3/visual_parameters.yaml
    - urdf/inc/ur_macro.xacro  (link/joint topology)

  Visual meshes: .dae (Collada).  Collision meshes: .stl.
  If Unity's URDF Importer fails on the .dae visuals, use ur3_stl.urdf instead.

  Place this file at the root of the 'ur_description' package folder so the
  package:// mesh paths resolve correctly in the Unity URDF Importer.
-->
<robot name="ur3_robot">

  <material name="LightGrey">
    <color rgba="0.7 0.7 0.7 1.0"/>
  </material>

  <!-- ===================== LINKS ===================== -->

  <link name="base_link"/>

  <link name="base_link_inertia">
    <visual>
      <origin xyz="0 0 0" rpy="0 0 3.141592653589793"/>
      <geometry>
        <mesh filename="package://ur_description/meshes/ur3/visual/base.dae"/>
      </geometry>
      <material name="LightGrey"/>
    </visual>
    <collision>
      <origin xyz="0 0 0" rpy="0 0 3.141592653589793"/>
      <geometry>
        <mesh filename="package://ur_description/meshes/ur3/collision/base.stl"/>
      </geometry>
    </collision>
    <inertial>
      <mass value="2.0"/>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <inertia ixx="0.00305316266" ixy="0.0" ixz="0.0" iyy="0.00305316266" iyz="0.0" izz="0.005625"/>
    </inertial>
  </link>

  <link name="shoulder_link">
    <visual>
      <origin xyz="0 0 0" rpy="0 0 3.141592653589793"/>
      <geometry>
        <mesh filename="package://ur_description/meshes/ur3/visual/shoulder.dae"/>
      </geometry>
      <material name="LightGrey"/>
    </visual>
    <collision>
      <origin xyz="0 0 0" rpy="0 0 3.141592653589793"/>
      <geometry>
        <mesh filename="package://ur_description/meshes/ur3/collision/shoulder.stl"/>
      </geometry>
    </collision>
    <inertial>
      <mass value="2.0"/>
      <origin xyz="0.0 0.0 -0.02" rpy="0 0 0"/>
      <inertia ixx="0.008093166666666665" ixy="0.0" ixz="0.0" iyy="0.008093166666666665" iyz="0.0" izz="0.005625"/>
    </inertial>
  </link>

  <link name="upper_arm_link">
    <visual>
      <origin xyz="0 0 0.1198" rpy="1.5707963267948966 0 -1.5707963267948966"/>
      <geometry>
        <mesh filename="package://ur_description/meshes/ur3/visual/upperarm.dae"/>
      </geometry>
      <material name="LightGrey"/>
    </visual>
    <collision>
      <origin xyz="0 0 0.1198" rpy="1.5707963267948966 0 -1.5707963267948966"/>
      <geometry>
        <mesh filename="package://ur_description/meshes/ur3/collision/upperarm.stl"/>
      </geometry>
    </collision>
    <inertial>
      <mass value="3.42"/>
      <origin xyz="-0.11365 0.0 0.1157" rpy="0 1.570796326794897 0"/>
      <inertia ixx="0.021728491912499998" ixy="0.0" ixz="0.0" iyy="0.021728491912499998" iyz="0.0" izz="0.00961875"/>
    </inertial>
  </link>

  <link name="forearm_link">
    <visual>
      <origin xyz="0 0 0.0275" rpy="1.5707963267948966 0 -1.5707963267948966"/>
      <geometry>
        <mesh filename="package://ur_description/meshes/ur3/visual/forearm.dae"/>
      </geometry>
      <material name="LightGrey"/>
    </visual>
    <collision>
      <origin xyz="0 0 0.0275" rpy="1.5707963267948966 0 -1.5707963267948966"/>
      <geometry>
        <mesh filename="package://ur_description/meshes/ur3/collision/forearm.stl"/>
      </geometry>
    </collision>
    <inertial>
      <mass value="1.26"/>
      <origin xyz="-0.16325 0.0 0.0238" rpy="0 1.570796326794897 0"/>
      <inertia ixx="0.0065468090625" ixy="0.0" ixz="0.0" iyy="0.0065468090625" iyz="0.0" izz="0.00354375"/>
    </inertial>
  </link>

  <link name="wrist_1_link">
    <visual>
      <origin xyz="0 0 -0.085" rpy="1.5707963267948966 0 0"/>
      <geometry>
        <mesh filename="package://ur_description/meshes/ur3/visual/wrist1.dae"/>
      </geometry>
      <material name="LightGrey"/>
    </visual>
    <collision>
      <origin xyz="0 0 -0.085" rpy="1.5707963267948966 0 0"/>
      <geometry>
        <mesh filename="package://ur_description/meshes/ur3/collision/wrist1.stl"/>
      </geometry>
    </collision>
    <inertial>
      <mass value="0.8"/>
      <origin xyz="0.0 -0.01 0.0" rpy="0 0 0"/>
      <inertia ixx="0.0016106414999999998" ixy="0.0" ixz="0.0" iyy="0.0016106414999999998" iyz="0.0" izz="0.00225"/>
    </inertial>
  </link>

  <link name="wrist_2_link">
    <visual>
      <origin xyz="0 0 -0.083" rpy="0 0 0"/>
      <geometry>
        <mesh filename="package://ur_description/meshes/ur3/visual/wrist2.dae"/>
      </geometry>
      <material name="LightGrey"/>
    </visual>
    <collision>
      <origin xyz="0 0 -0.083" rpy="0 0 0"/>
      <geometry>
        <mesh filename="package://ur_description/meshes/ur3/collision/wrist2.stl"/>
      </geometry>
    </collision>
    <inertial>
      <mass value="0.8"/>
      <origin xyz="0.0 0.01 0.0" rpy="0 0 0"/>
      <inertia ixx="0.0015721739999999998" ixy="0.0" ixz="0.0" iyy="0.0015721739999999998" iyz="0.0" izz="0.00225"/>
    </inertial>
  </link>

  <link name="wrist_3_link">
    <visual>
      <origin xyz="0 -0.00255 -0.082" rpy="1.5707963267948966 0 0"/>
      <geometry>
        <mesh filename="package://ur_description/meshes/ur3/visual/wrist3.dae"/>
      </geometry>
      <material name="LightGrey"/>
    </visual>
    <collision>
      <origin xyz="0 -0.00255 -0.082" rpy="1.5707963267948966 0 0"/>
      <geometry>
        <mesh filename="package://ur_description/meshes/ur3/collision/wrist3.stl"/>
      </geometry>
    </collision>
    <inertial>
      <mass value="0.35"/>
      <origin xyz="0.0 0.0 -0.02" rpy="0 0 0"/>
      <inertia ixx="0.00013626666666666665" ixy="0.0" ixz="0.0" iyy="0.00013626666666666665" iyz="0.0" izz="0.0001792"/>
    </inertial>
  </link>

  <link name="base"/>
  <link name="flange"/>
  <link name="tool0"/>

  <!-- ===================== JOINTS ===================== -->

  <joint name="base_link-base_link_inertia" type="fixed">
    <parent link="base_link"/>
    <child link="base_link_inertia"/>
    <origin xyz="0 0 0" rpy="0 0 3.141592653589793"/>
  </joint>

  <joint name="shoulder_pan_joint" type="revolute">
    <parent link="base_link_inertia"/>
    <child link="shoulder_link"/>
    <origin xyz="0 0 0.1519" rpy="0 0 0"/>
    <axis xyz="0 0 1"/>
    <limit lower="-6.283185307179586" upper="6.283185307179586" effort="56.0" velocity="3.141592653589793"/>
    <dynamics damping="0" friction="0"/>
  </joint>

  <joint name="shoulder_lift_joint" type="revolute">
    <parent link="shoulder_link"/>
    <child link="upper_arm_link"/>
    <origin xyz="0 0 0" rpy="1.570796327 0 0"/>
    <axis xyz="0 0 1"/>
    <limit lower="-6.283185307179586" upper="6.283185307179586" effort="56.0" velocity="3.141592653589793"/>
    <dynamics damping="0" friction="0"/>
  </joint>

  <joint name="elbow_joint" type="revolute">
    <parent link="upper_arm_link"/>
    <child link="forearm_link"/>
    <origin xyz="-0.24365 0 0" rpy="0 0 0"/>
    <axis xyz="0 0 1"/>
    <limit lower="-3.141592653589793" upper="3.141592653589793" effort="28.0" velocity="3.141592653589793"/>
    <dynamics damping="0" friction="0"/>
  </joint>

  <joint name="wrist_1_joint" type="revolute">
    <parent link="forearm_link"/>
    <child link="wrist_1_link"/>
    <origin xyz="-0.21325 0 0.11235" rpy="0 0 0"/>
    <axis xyz="0 0 1"/>
    <limit lower="-6.283185307179586" upper="6.283185307179586" effort="12.0" velocity="6.283185307179586"/>
    <dynamics damping="0" friction="0"/>
  </joint>

  <joint name="wrist_2_joint" type="revolute">
    <parent link="wrist_1_link"/>
    <child link="wrist_2_link"/>
    <origin xyz="0 -0.08535 -1.750557762378351e-11" rpy="1.570796327 0 0"/>
    <axis xyz="0 0 1"/>
    <limit lower="-6.283185307179586" upper="6.283185307179586" effort="12.0" velocity="6.283185307179586"/>
    <dynamics damping="0" friction="0"/>
  </joint>

  <joint name="wrist_3_joint" type="revolute">
    <parent link="wrist_2_link"/>
    <child link="wrist_3_link"/>
    <origin xyz="0 0.0819 -1.679797079540562e-11" rpy="1.570796326589793 3.141592653589793 3.141592653589793"/>
    <axis xyz="0 0 1"/>
    <limit lower="-6.283185307179586" upper="6.283185307179586" effort="12.0" velocity="6.283185307179586"/>
    <dynamics damping="0" friction="0"/>
  </joint>

  <joint name="base_link-base_fixed_joint" type="fixed">
    <origin xyz="0 0 0" rpy="0 0 3.141592653589793"/>
    <parent link="base_link"/>
    <child link="base"/>
  </joint>

  <joint name="wrist_3-flange" type="fixed">
    <parent link="wrist_3_link"/>
    <child link="flange"/>
    <origin xyz="0 0 0" rpy="0 -1.5707963267948966 -1.5707963267948966"/>
  </joint>

  <joint name="flange-tool0" type="fixed">
    <origin xyz="0 0 0" rpy="1.5707963267948966 0 1.5707963267948966"/>
    <parent link="flange"/>
    <child link="tool0"/>
  </joint>

</robot>
