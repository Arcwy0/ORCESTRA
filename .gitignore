# ==== Unity ====
[Ll]ibrary/
[Tt]emp/
[Oo]bj/
[Bb]uild/
[Bb]uilds/
[Ll]ogs/
[Uu]ser[Ss]ettings/
[Mm]emoryCaptures/

# Auto-generated by Unity when the editor was killed / crashed
[Aa]ssets/_[Rr]ecovery/
[Aa]ssets/_[Rr]ecovery.meta
# Stray XR Simulation scratch folder Unity sometimes drops under Assets/
[Aa]ssets/**/[Tt]emp.meta

# Unity / IL2CPP intermediate cache
.utmp/

# Local APK output folders Build And Run can drop next to the project
# (the *.apk pattern below covers the actual APK; this catches the
# BurstDebugInformation_DoNotShip folder Unity puts beside it)
[Aa][Pp][Kk]_[Bb]uild*/

# Asset meta data should only be ignored when the corresponding asset is also ignored
!/[Aa]ssets/**/*.meta

# Autogenerated VS/Rider/IDE files
.vs/
.idea/
.vsconfig
*.csproj
*.sln
*.slnx
*.user
*.unityproj
*.suo
*.tmp
*.pidb
*.booproj
*.svd
*.userprefs

# Unity3D generated
ExportedObj/
.consulo/
*.apk
*.aab
*.unitypackage
*.app
crashlytics-build.properties
sysinfo.txt

# OS
.DS_Store
Thumbs.db

# Python service caches
__pycache__/
*.py[cod]

# Local/server model weights and generated AI traces
[Mm]odels/
server/deploy/models/
server/deploy/outputs/
outputs/

# Meta Immersive Debugger local dev-agent settings may contain access tokens.
[Aa]ssets/[Rr]esources/[Dd]ev[Aa]gent[Ss]ettings.asset
[Aa]ssets/[Rr]esources/[Dd]ev[Aa]gent[Ss]ettings.asset.meta

# Unity Performance Testing package run artifacts.
[Aa]ssets/[Rr]esources/[Pp]erformance[Tt]est[Rr]un*.json
[Aa]ssets/[Rr]esources/[Pp]erformance[Tt]est[Rr]un*.json.meta

# Keep this after the Unity meta-file exception above.
[Aa]ssets/**/[Tt]emp.meta
